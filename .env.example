# 🏙️ BIMS2 - Environment Configuration Example
# Copy this file to '.env' and modify for local development.
# ---------------------------------------------------------

# ─── CORE DJANGO SETTINGS ───
# Set to 'True' for development, 'False' for production testing.
DEBUG=True

# Use a unique, secure key for your local environment.
SECRET_KEY=django-insecure-your-local-development-key-change-me


# ─── SERVER CONFIGURATION ───
# Interface and port for the application server (Waitress/Dev Server)
BIMS_HOST=127.0.0.1
BIMS_PORT=8001


# ─── DATABASE CONFIGURATION ───                   
# BIMS2 defaults to SQLite, but production should use PostgreSQL.

# Option 1: SQLite (Default for Dev)
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3

# Option 2: PostgreSQL (Recommended for Production)
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=bims2
# DATABASE_USER=bims2_user
# DATABASE_PASSWORD=bims2_password
# DATABASE_HOST=db
# DATABASE_PORT=5432


# ─── SECURITY & ACCESS ───
# Comma-separated list of hostnames this Django site can serve.
ALLOWED_HOSTS=localhost,127.0.0.1


# ─── BIMS2 APPLICATION SETTINGS ───
# Root directory for all BIMS2 data (sqlite, uploads, logs).
BIMS_DATA_ROOT=./test_data

# Portable Mode: If True, all data is stored relative to the project root.
BIMS_PORTABLE_MODE=True

# Technical Tier: 'community', 'pro', or 'ultra'.
BIMS_DEBUG_TIER=ultra

# Security Bypass: Set to 'True' to disable license checks during development.
LICENSE_DEBUG_BYPASS=True

# Certificate Storage: Custom path for issued PDF certificates.
# If empty, defaults to BIMS_DATA_ROOT/certificates
BIMS_CERTIFICATE_STORAGE_ROOT=


# ─── 🚀 SMART PROFILE OVERRIDES (PRODUCTION TEST / DOCKER) ───
# These settings are activated when running with: ./run.ps1 prod
# They allow you to simulate a production environment locally.

PROD_DEBUG=False
PROD_SECRET_KEY=yoursupersecureproductiontestkey
PROD_ALLOWED_HOSTS=*
PROD_BIMS_DATA_ROOT=/app/data
PROD_BIMS_PORTABLE_MODE=False

# Production Security Simulation
PROD_SECURE_SSL_REDIRECT=False
PROD_SECURE_HSTS_SECONDS=0
PROD_SESSION_COOKIE_SECURE=False
PROD_CSRF_COOKIE_SECURE=False

# Production Tier/Bypass
PROD_LICENSE_DEBUG_BYPASS=True
PROD_BIMS_DEBUG_TIER=ultra
